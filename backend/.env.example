# Local dev only. Staging/production secrets live in Vault/Secrets Manager,
# never in this file or committed anywhere (AGENTS.md règle 9, docs/security.md §10).
DOCUCIV_ENVIRONMENT=dev
DOCUCIV_DATABASE_URL=postgresql+asyncpg://docuciv:docuciv@localhost:5432/docuciv
DOCUCIV_REDIS_URL=redis://localhost:6379/0
DOCUCIV_SECRET_KEY=local-dev-only-not-a-real-secret
DOCUCIV_LOG_LEVEL=INFO

# No origin is trusted by default (docs/security.md §2). Required outside dev.
DOCUCIV_CORS_ALLOWED_ORIGINS=["http://localhost:3000"]
