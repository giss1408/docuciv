# Copier vers .env (ignoré par git). En staging/production: variables injectées par
# Vault / Secrets Manager, jamais de fichier .env commité.
DOCUCIV_ENVIRONMENT=dev
DOCUCIV_DATABASE_URL=postgresql+asyncpg://docuciv_app:docuciv_app@localhost:5432/docuciv
DOCUCIV_MIGRATION_DATABASE_URL=postgresql+asyncpg://docuciv_owner:docuciv_owner@localhost:5432/docuciv
DOCUCIV_REDIS_URL=redis://localhost:6379/0
# Requis hors dev pour la migration qui crée le rôle applicatif
# DOCUCIV_APP_DB_PASSWORD=

# Démo uniquement (staging). Refusé en production. Connexion jetable POST /demo/login.
# DOCUCIV_DEMO_MODE=true
# DOCUCIV_DEMO_ACCESS_CODE=<8+ caractères, donné aux présentateurs>
# DOCUCIV_DEMO_TOKEN_SECRET=<32+ caractères aléatoires>
# DOCUCIV_DEMO_CITIZEN_PHONE=+225XXXXXXXXXX   # le téléphone de WhatsApp qui recevra les messages
# DOCUCIV_CORS_ORIGINS=["https://demo-admin.example.ci"]
# DOCUCIV_NOTIFICATION_TRANSPORT=whatsapp_manual
